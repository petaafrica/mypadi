# .env - MINIMUM FOR DEVELOPMENT

# FastAPI
DEBUG=true
PORT=9000

# Twilio (Get from Twilio console)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here

# Supabase (Get from Supabase project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# For now, leave others empty or with dummy values
OPENROUTER_API_KEY=sk-or-not-needed-yet
VTPASS_API_KEY=not-needed-yet